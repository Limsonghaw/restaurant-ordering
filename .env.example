# 本地开发可选择 mock；正式站点必须使用 supabase。
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 以下公开测试 site key 仅用于开发和预览，生产构建禁止：
# 1x00000000000000000000AA 总是通过
# 2x00000000000000000000AB 总是失败
# 3x00000000000000000000FF 强制交互验证
NEXT_PUBLIC_AUTH_SMS_ALLOWED_COUNTRIES=MY
# Supabase 公开配置和站点 origin（无尾斜杠）。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
# 优先使用新版公开 key；未填写时兼容 ANON_KEY。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 以下仅服务端使用；PR3 顾客接口必需，缺失时拒绝请求。
CUSTOMER_API_DATABASE_URL=
# 仅本地，生产不要设置：仅 loopback 主机且非生产允许 disable；默认 require
CUSTOMER_DB_SSL=require
# disable only locally for exact URL hostname localhost / 127.0.0.1; never hosted
# 仅本地，生产不要设置：1 允许读取 XFF 首地址（或 x-real-ip）
# TRUST_LOCAL_IP=1  # local only; omit entirely in hosted/production environments
QR_SIGNING_SECRET=
CLIENT_HASH_SECRET=
DEVICE_COOKIE_SECRET=
# Supabase Auth Dashboard CAPTCHA；PR3 下单 siteverify 同时检查 place_order 与站点 hostname。
# 仅开发/测试可用官方测试 secret；真实 secret 只在环境配置。
TURNSTILE_SECRET_KEY=
# 仅 Supabase Auth 使用，生产 Dashboard 启用 Twilio Verify。
TWILIO_ACCOUNT_SID=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_AUTH_TOKEN=
# PR3 REST 限流：两项需同时配置；缺失/故障时下单要求 Turnstile，其他接口返回 429。
# 认证由 Supabase Auth + Twilio 限流。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
